{
  "$schema": "https://schema.tauri.app/v2/config",
  "productName": "Nexus Vault",
  "version": "0.3.0",
  "identifier": "com.nexusvault.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && cargo build --release --bin nexus-vault-host --manifest-path src-tauri/Cargo.toml",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": [
      "app"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Vault",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none';",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nexus Vault",
    "copyright": "© 2026 Nexus Vault",
    "category": "Utility",
    "shortDescription": "Gestor de contraseñas local y cifrado",
    "longDescription": "Nexus Vault guarda tus contraseñas, tarjetas y notas cifradas con Argon2id y XChaCha20-Poly1305 en tu propio equipo, e incluye la extensión para Microsoft Edge.",
    "resources": {
      "target/release/nexus-vault-host.exe": "nexus-vault-host.exe",
      "windows/com.nexusvault.host.json": "com.nexusvault.host.json",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/background.js": "extension/background.js",
      "../extension/content.js": "extension/content.js",
      "../extension/popup.html": "extension/popup.html",
      "../extension/popup.js": "extension/popup.js",
      "../extension/icons/": "extension/icons/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
