{
  "manifest_version": 3,
  "name": "Nexus Vault",
  "version": "0.1.0",
  "description": "Rellena tus contraseñas de Nexus Vault en Edge.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" }
}
